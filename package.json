{
  "name": "tinar-webar",
  "version": "0.1.0",
  "description": "TinAR WebAR Dental Educativo - Experiencia WebAR educativa para enseñar técnica correcta de cepillado dental a niños de 3-8 años",
  "main": "index.html",
  "scripts": {
    "optimize": "gltf-transform draco Modelo3D/Tina.glb assets/models/Tina_optimized.glb",
    "optimize:resize": "gltf-transform resize assets/models/Tina_temp.glb assets/models/Tina_optimized.glb --textures 1024x1024",
    "optimize:simplify": "gltf-transform simplify Modelo3D/Tina.glb assets/models/Tina_optimized.glb --ratio 0.5 --error 0.01",
    "inspect": "gltf-transform inspect assets/models/Tina_optimized.glb"
  },
  "keywords": [
    "webar",
    "ar",
    "dental",
    "education",
    "mindar",
    "aframe",
    "children",
    "brushing"
  ],
  "author": "TinAR Team",
  "license": "MIT",
  "devDependencies": {
    "@gltf-transform/cli": "^4.0.0"
  }
}
